# Reordenar y agregar variables auxiliares
physician_min_max <- physician_min_max %>%
arrange(desc(max_value)) %>%
mutate(`Reference area` = factor(`Reference area`, levels = `Reference area`))
# Crear tabla en formato largo para que ggplot maneje los puntos y leyenda
datos_long <- physician_min_max %>%
select(`Reference area`, min_value, max_value) %>%
tidyr::pivot_longer(cols = c(min_value, max_value),
names_to = "tipo", values_to = "valor") %>%
mutate(tipo = ifelse(tipo == "min_value", "Valor mínimo", "Valor máximo"))
# Gráfico con leyenda
ggplot() +
geom_segment(data = physician_min_max,
aes(x = `Reference area`, xend = `Reference area`,
y = min_value, yend = max_value),
color = "grey50", linewidth = 1) +
geom_point(data = datos_long,
aes(x = `Reference area`, y = valor, fill = tipo),
shape = 21, size = 3, color = "black") +
scale_fill_manual(values = c("Valor mínimo" = "white", "Valor máximo" = "green")) +
geom_label(data = physician_min_max,
aes(x = `Reference area`, y = max_value,
label = round(max_value, 1)),
size = 4, fill = "white", color = "black", label.size = 0.25) +
geom_text(data = physician_min_max,
aes(x = `Reference area`, y = max_value - 0.15, label = max_time),
size = 2.8) +
geom_text(data = physician_min_max,
aes(x = `Reference area`, y = min_value, label = min_time),
vjust = 1.8, size = 3) +
labs(title = "Densidad de profesionales de medicina por 1,000 habitantes",
fill = "Tipo de valor",
y = "Densidad", x = "",
caption = "Fuente: OCDE (OECD) API - https://stats.oecd.org/") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
