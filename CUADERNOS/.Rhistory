geom_point(aes(x = `Reference area`, y = max_value),
color = "darkgreen", fill ="#32B2A5", shape = 21, size = 3) +
# Valor máximo encerrado en un cuadro
geom_label(aes(x = `Reference area`, y = max_value+0.2,
label = round(max_value, 1)),
size = 3, fill = ""gray, color = "black") +
size = 3, fill = "gray"", color = "black") +
# Gráfico
ggplot(physician_min_max) +
geom_segment(aes(x = `Reference area`, xend = `Reference area`,
y = min_value, yend = max_value),
color = "grey50", linewidth = 1) +
geom_point(aes(x = `Reference area`, y = min_value),
color = "black", fill = "white", shape = 21, size = 3) +
geom_point(aes(x = `Reference area`, y = max_value),
color = "darkgreen", fill ="#32B2A5", shape = 21, size = 3) +
# Valor máximo encerrado en un cuadro
geom_label(aes(x = `Reference area`, y = max_value+0.2,
label = round(max_value, 1)),
size = 3, fill = "gray", color = "black") +
# Año debajo, más pequeño
geom_text(aes(x = `Reference area`, y = max_value - 0.15,
label = max_time),
size = 2.8, color = "black") +
# Etiqueta del año mínimo
geom_text(aes(x = `Reference area`, y = min_value, label = min_time),
vjust = 1.8, size = 3) +
labs(title = "Densidad de profesionales de medicina por 1,000 habitantes",
y = "Densidad", x = "",
caption = "Fuente: OCDE (OECD) API - https://stats.oecd.org/") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
